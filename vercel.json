{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/css/:path*", "destination": "/css/:path*" },
    { "source": "/js/:path*", "destination": "/js/:path*" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/supabase/:path*", "destination": "/supabase/:path*" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/about", "destination": "/public/about.html" },
    { "source": "/about.html", "destination": "/public/about.html" },
    { "source": "/news", "destination": "/public/news.html" },
    { "source": "/news.html", "destination": "/public/news.html" },
    { "source": "/events", "destination": "/public/events.html" },
    { "source": "/events.html", "destination": "/public/events.html" },
    { "source": "/results", "destination": "/public/results.html" },
    { "source": "/results.html", "destination": "/public/results.html" },
    { "source": "/documents", "destination": "/public/documents.html" },
    { "source": "/documents.html", "destination": "/public/documents.html" },
    { "source": "/gallery", "destination": "/public/gallery.html" },
    { "source": "/gallery.html", "destination": "/public/gallery.html" },
    { "source": "/contact", "destination": "/public/contact.html" },
    { "source": "/contact.html", "destination": "/public/contact.html" }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
